<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.nexus.launcher" />
        <intent>
            <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusCompanion">

        <activity
            android:name=".CompanionActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Exported so the launcher can bind it. Access is enforced inside the
          service: every call checks the caller is the Nexus launcher AND is
          signed with this companion's key. A manifest permission is not used
          because signature permissions are granted at install time, which would
          break whenever the launcher happened to be installed first.
        -->
        <service
            android:name=".NexusOverlayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nexus.companion.OVERLAY_BRIDGE" />
            </intent-filter>
        </service>

    </application>
</manifest>
